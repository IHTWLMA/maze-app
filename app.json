{
  "expo": {
    "name": "Maze",
    "slug": "knowledge-sink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cover.jpg",
    "scheme": "knowledge-sink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/cover.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.maze.knowledge",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94cfe880-ce08-4909-be19-fed31223dab1"
      }
    },
    "owner": "jasonugs-team"
  }
}